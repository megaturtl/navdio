"""Used python-mpd2 API. Upstream command decorators erase types."""

from typing import TypedDict

class MPDError(Exception): ...

class PlaylistEntry(TypedDict):
    file: str

class MPDClient:
    timeout: float | None

    def connect(self, host: str, port: int = ...) -> None: ...
    def disconnect(self) -> None: ...
    def status(self) -> dict[str, str]: ...
    def clear(self) -> None: ...
    def repeat(self, state: int) -> None: ...
    def random(self, state: int) -> None: ...
    def single(self, state: int) -> None: ...
    def consume(self, state: int) -> None: ...
    def add(self, uri: str) -> None: ...
    def play(self, songpos: int = ...) -> None: ...
    def stop(self) -> None: ...
    def pause(self, state: int) -> None: ...
    def seek(self, songpos: int, offset: float) -> None: ...
    def playlistinfo(self) -> list[PlaylistEntry]: ...
